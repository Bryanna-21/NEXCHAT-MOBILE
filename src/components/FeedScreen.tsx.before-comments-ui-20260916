                  <Text style={[styles.cancelText, { color: theme.ink }]}>
                    Cancel
                  </Text>
                </Pressable>

                <Pressable
                  onPress={() =>
                    publish(
                      attachment
                        ? "file"
                        : linkUrl.trim()
                          ? "link"
                          : "text",
                    )
                }
                  disabled={
                    publishing ||
                    (!text.trim() &&
                      !attachment &&
                      !linkUrl.trim())
