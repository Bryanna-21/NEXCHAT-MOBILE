import {
  storeAttachment,
  deleteAttachment,
  StoredAttachment,
} from "./attachmentStore";

import {
  validateAttachment,
  attachmentTypeFromMime,
} from "./attachmentValidation";

import { Attachment } from "./store";

export interface AttachmentInput {
  uri: string;
  name?: string;
  mimeType?: string;
  size?: number;
  duration?: number;
  width?: number;
  height?: number;
  type?: Attachment["type"];
}

export interface AttachmentIngestionResult {
  attachment: Attachment;
  stored: boolean;
}

function makeAttachmentId(): string {
  return (
    `att-${Date.now()}-` +
    Math.random()
      .toString(36)
      .slice(2, 10)
  );
}

function buildAttachment(
  input: AttachmentInput,
  stored: StoredAttachment,
): Attachment {
  return {
    id: stored.id,
    type: stored.type,
    uri: stored.uri,
    name: stored.name,
    mimeType: stored.mimeType,
    size: stored.size,
    duration: input.duration,
    width: input.width,
    height: input.height,
  };
}

export async function ingestAttachment(
  input: AttachmentInput,
): Promise<AttachmentIngestionResult> {
  if (!input.uri) {
    throw new Error(
      "Attachment URI is missing.",
    );
  }

  const validation =
    validateAttachment({
      uri: input.uri,
      mimeType: input.mimeType,
      fileName: input.name,
      fileSize: input.size,
      type: input.type,
    });

  if (!validation.valid) {
    throw new Error(
      validation.reason ||
        "Attachment validation failed.",
    );
  }

  const id =
    makeAttachmentId();

  const type =
    input.type ||
    attachmentTypeFromMime(
      input.mimeType,
    );

  const candidate: StoredAttachment = {
    id,
    type,
    uri: input.uri,
    name: input.name,
    mimeType: input.mimeType,
    size: input.size,
    createdAt:
      new Date().toISOString(),
  };

  try {
    const stored =
      await storeAttachment(
        candidate,
      );

    return {
      attachment:
        buildAttachment(
          input,
          stored,
        ),
      stored: true,
    };
  } catch (error) {
    /*
     * If the storage operation created the destination
     * before failing verification, remove it.
     *
     * This is intentionally best-effort cleanup.
     * The original failure is preserved.
     */
    try {
      await deleteAttachment(id);
    } catch {
      // Preserve the original ingestion error.
    }

    throw error;
  }
}

/**
 * Transactional multi-attachment ingestion.
 *
 * If any attachment fails, every attachment successfully
 * stored during this operation is deleted.
 */
export async function ingestAttachments(
  inputs: AttachmentInput[],
): Promise<Attachment[]> {
  const results: Attachment[] = [];

  try {
    for (const input of inputs) {
      const result =
        await ingestAttachment(
          input,
        );

      results.push(
        result.attachment,
      );
    }

    return results;
  } catch (error) {
    /*
     * Roll back everything created by this
     * ingestion transaction.
     */
    for (const attachment of results) {
      try {
        await deleteAttachment(
          attachment.id,
        );
      } catch {
        // Best-effort rollback.
      }
    }

    throw error;
  }
}
